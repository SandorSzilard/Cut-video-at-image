# Ignore input videos and generated outputs (do not commit user media or derived files)
Input/
Videos/

# Ignore logs and outputs (generated artifacts)
Logs/
Outputs/
CutLogs/

# Ignore optional web UI / artifacts (not required for automated pipeline)
index.html
*.js
html/
scripts/

# Ignore ffmpeg binaries (do not commit these)
ffmpeg.exe
ffplay.exe
ffprobe.exe

# Ignore generated images and thumbnails
*.png
*.jpg
*.jpeg
*_ref.*

# Ignore user-specific runtime decisions
.user_decisions.json

# Optional: ignore editor/project files
*.user
*.vs
*.suo
.vscode/



